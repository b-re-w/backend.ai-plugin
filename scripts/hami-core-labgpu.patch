+/*
+ * labgpu: CUDA_VISIBLE_DEVICES may list GPU UUIDs ("GPU-..."), which HAMi-core's parser reads as
+ * index 0. Map each UUID to its NVML index so limits, nvidia-smi and host pid detection use the
+ * right physical GPU; CUDA indices beyond the list map to nothing (-1). Returns the count, or -1
+ * when the variable is not a UUID list.
+ *
+ * Only the real NVML entry points are called: this runs inside nvml_postInit (under the
+ * pthread_once of the hooked nvmlInit), and calling a hooked NVML function there deadlocks.
+ * From the CUDA side (in_nvml_init == 0) NVML is initialised first through the hooked nvmlInit_v2,
+ * which loads the real entry points and runs nvml_postInit (and so this mapping) once.
+ */
+nvmlReturn_t nvmlInit_v2(void);  /* defined below (hooked); nvml-subset.h declares no functions */
+
+int labgpu_map_visible_uuids(int in_nvml_init) {
+    char *env = getenv("CUDA_VISIBLE_DEVICES");
+    if (env == NULL || strncmp(env, "GPU-", 4) != 0) {
+        return -1;
+    }
+    if (!in_nvml_init && nvmlInit_v2() != NVML_SUCCESS) {
+        return -1;
+    }
+    char buf[4096];
+    strncpy(buf, env, sizeof(buf) - 1);
+    buf[sizeof(buf) - 1] = 0;
+    int mapped[CUDA_DEVICE_MAX_COUNT];
+    int count = 0;
+    char *save = NULL;
+    for (char *tok = strtok_r(buf, ",", &save); tok != NULL; tok = strtok_r(NULL, ",", &save)) {
+        nvmlDevice_t device;
+        unsigned int index;
+        if (count >= CUDA_DEVICE_MAX_COUNT || strncmp(tok, "GPU-", 4) != 0
+            || NVML_OVERRIDE_CALL_NO_LOG(nvml_library_entry, nvmlDeviceGetHandleByUUID, tok, &device) != NVML_SUCCESS
+            || NVML_OVERRIDE_CALL_NO_LOG(nvml_library_entry, nvmlDeviceGetIndex, device, &index) != NVML_SUCCESS) {
+            LOG_WARN("labgpu: cannot map CUDA_VISIBLE_DEVICES entry %s", tok);
+            return -1;
+        }
+        mapped[count++] = (int)index;
+    }
+    for (int i = 0; i < CUDA_DEVICE_MAX_COUNT; i++) {
+        cuda_to_nvml_map_array[i] = (i < count) ? mapped[i] : -1;
+    }
+    for (int i = 0; i < count; i++) {
+        LOG_INFO("labgpu: device %d -> nvml %d", i, cuda_to_nvml_map_array[i]);
+    }
+    return count;
+}
+
 void nvml_postInit() {
     init_device_info();
+    /* labgpu: NVML-only programs (nvidia-smi) never run the CUDA-side mapping. */
+    labgpu_map_visible_uuids(1);
 }
 
 nvmlReturn_t _nvmlDeviceGetMemoryInfo(nvmlDevice_t device,void* memory,int version) {
@@ -338,6 +387,20 @@ nvmlReturn_t _nvmlDeviceGetMemoryInfo(nvmlDevice_t device,void* memory,int versi
     CHECK_NVML_API(nvmlDeviceGetIndex(device, &dev_id));
     int cudadev = nvml_to_cuda_map(dev_id);
     if (cudadev < 0) {
+        /* labgpu: a spot session may use only its own GPU; show every other one as 1 MiB, free. */
+        char *spot = getenv("LABGPU_SPOT");
+        if (spot != NULL && strcmp(spot, "1") == 0) {
+            unsigned long long blocked = 1ULL << 20;
+            if (version == 1) {
+                ((nvmlMemory_t*)memory)->total = blocked;
+                ((nvmlMemory_t*)memory)->free = blocked;
+                ((nvmlMemory_t*)memory)->used = 0;
+            } else {
+                ((nvmlMemory_v2_t*)memory)->total = blocked;
+                ((nvmlMemory_v2_t*)memory)->free = blocked;
+                ((nvmlMemory_v2_t*)memory)->used = 0;
+            }
+        }
         return NVML_SUCCESS;
     }
     size_t usage = get_current_device_memory_usage(cuda_to_nvml_map(cudadev));
