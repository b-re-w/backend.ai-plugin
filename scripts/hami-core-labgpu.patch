+/*
+ * labgpu: CUDA_VISIBLE_DEVICES may list GPU UUIDs ("GPU-..."), which atoi() reads as 0. Map each
+ * UUID to its NVML index so limits, nvidia-smi and host pid detection use the right physical GPU;
+ * CUDA indices beyond the list map to nothing (-1). Returns the count, or -1 if not all UUIDs.
+ */
+int labgpu_map_visible_uuids() {
+    char *env = getenv("CUDA_VISIBLE_DEVICES");
+    if (env == NULL || strncmp(env, "GPU-", 4) != 0) {
+        return -1;
+    }
+    char buf[4096];
+    strncpy(buf, env, sizeof(buf) - 1);
+    buf[sizeof(buf) - 1] = '\0';
+    if (nvmlInit() != NVML_SUCCESS) {
+        return -1;
+    }
+    int mapped[CUDA_DEVICE_MAX_COUNT];
+    int count = 0;
+    char *save = NULL;
+    for (char *tok = strtok_r(buf, ",", &save); tok != NULL; tok = strtok_r(NULL, ",", &save)) {
+        nvmlDevice_t device;
+        unsigned int index;
+        if (count >= CUDA_DEVICE_MAX_COUNT || strncmp(tok, "GPU-", 4) != 0
+            || nvmlDeviceGetHandleByUUID(tok, &device) != NVML_SUCCESS
+            || nvmlDeviceGetIndex(device, &index) != NVML_SUCCESS) {
+            LOG_WARN("labgpu: cannot map CUDA_VISIBLE_DEVICES entry %s", tok);
+            return -1;
+        }
+        mapped[count++] = (int)index;
+    }
+    for (int i = 0; i < CUDA_DEVICE_MAX_COUNT; i++) {
+        cuda_to_nvml_map_array[i] = (i < count) ? mapped[i] : -1;
+    }
+    for (int i = 0; i < count; i++) {
+        LOG_INFO("labgpu: device %d -> nvml %d", i, cuda_to_nvml_map_array[i]);
+    }
+    return count;
+}
+
 int parse_cuda_visible_env() {
     char *s = getenv("CUDA_VISIBLE_DEVICES");
-    int count = 0;
+    int count = labgpu_map_visible_uuids();
+    if (count >= 0) {
+        return count;
+    }
+    count = 0;
     for (int i = 0; i < CUDA_DEVICE_MAX_COUNT; i++) {
         cuda_to_nvml_map_array[i] = i;
     }
