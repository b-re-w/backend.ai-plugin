#!/bin/sh
# Mounted read-only into GPU sessions by the labgpu plugins (SPEC 1.14) and named in $BROWSER.
# Programs in the session (gh, Claude Code, python -m webbrowser) call this to open a URL. There is
# no browser in the container, so the URL goes to a per-session file that the WebUI desktop app
# polls through Backend.AI and opens in the user's default browser. Nothing here depends on a VS
# Code window or on the terminal (tmux, ttyd) the program runs in.
url="$1"
case "$url" in
  http://*|https://*|mailto:*) ;;
  *)
    echo "xdg-open (labgpu): only http, https and mailto URLs are supported: $url" >&2
    exit 3
    ;;
esac

for f in $(ls /home/work/.labgpu-browser/* 2>/dev/null | sort); do
  if [ -w "$f" ]; then
    # One line, "<nanoseconds> <url>": the app opens each new line once.
    printf '%s %s\n' "$(date +%s%N)" "$url" > "$f"
    echo "Opening in your browser through the Backend.AI desktop app: $url" >&2
    exit 0
  fi
done

echo "Open this URL in your browser: $url" >&2
exit 1
